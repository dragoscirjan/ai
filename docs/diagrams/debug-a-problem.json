  "cards": [
    {
      "dot": "amber",
      "title": "Evidence, not guesses",
      "items": [
        "Keep observations, hypotheses, and demonstrated causes separate.",
        "Regression evidence precedes the correction; selecting the full TDD skill is optional."
      ]
    },
    {
      "dot": "amber",
      "title": "Stop or reassess",
      "items": [
        "A diagnosis request does not authorize edits. Missing evidence is a blocker, not a reason to guess.",
        "After three failed corrective attempts, stop patching. Return to planning for broader scope."
      ]
    }
  ]
