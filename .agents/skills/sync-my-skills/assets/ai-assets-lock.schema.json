{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machine-owned skill synchronization state",
  "description": "Version 1 is read for reviewed migration; new writes use version 2. Root instructions are historical metadata only.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "managerVersion", "catalogHash", "source", "selection", "skills", "files", "projections", "legacyInstructions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "managerVersion": { "type": "string" },
    "catalogHash": { "$ref": "#/$defs/digest" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["repository", "ref"],
      "properties": { "repository": { "type": "string" }, "ref": { "type": "string" } }
    },
    "selection": { "$ref": "./selection.schema.json" },
    "skills": { "type": "object", "additionalProperties": { "$ref": "#/$defs/skill" } },
    "files": { "type": "object", "additionalProperties": { "$ref": "#/$defs/file" } },
    "legacyInstructions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/legacyFile" } },
    "projections": {
      "type": "object", "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["harness", "skill", "target"],
        "properties": {
          "harness": { "const": "claude-code" }, "skill": { "type": "string" },
          "target": { "type": "string" }, "retained": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digests": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "skill", "sourcePath", "installedSha256"],
      "properties": {
        "kind": { "const": "skill" }, "skill": { "type": "string" },
        "sourcePath": { "type": "string" },
        "sourceSha256": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "installedSha256": { "$ref": "#/$defs/digest" },
        "mode": { "enum": [420, 493] },
        "retained": { "type": "boolean" }, "retentionReason": { "type": "string" },
        "retainedFromCommit": { "type": "string" }
      }
    },
    "legacyFile": {
      "type": "object", "required": ["kind", "installedSha256"],
      "properties": { "kind": { "const": "instruction" }, "installedSha256": { "$ref": "#/$defs/digest" } }
    },
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "origin", "upstream", "legal", "recipeHash", "sourceFiles", "sourceModes", "inputHash", "contextHash", "outputHash"],
      "properties": {
        "kind": { "enum": ["authored", "upstream", "adapted"] },
        "origin": {
          "type": "object", "additionalProperties": false,
          "required": ["repository", "revision", "path"],
          "properties": {
            "repository": { "type": "string" }, "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "path": { "type": "string" }, "dirty": { "type": "boolean" }
          }
        },
        "upstream": { "anyOf": [{ "$ref": "./skill-catalog.schema.json#/$defs/source" }, { "type": "null" }] },
        "legal": { "type": "array", "items": { "type": "object" } },
        "recipeHash": { "$ref": "#/$defs/digest" }, "sourceFiles": { "$ref": "#/$defs/digests" },
        "sourceModes": { "type": "object", "additionalProperties": { "enum": [420, 493] } },
        "inputHash": { "$ref": "#/$defs/digest" }, "contextHash": { "$ref": "#/$defs/digest" },
        "outputHash": { "$ref": "#/$defs/digest" },
        "review": {
          "type": "object", "additionalProperties": false, "required": ["note", "outputHash"],
          "properties": { "note": { "type": "string", "minLength": 1 }, "outputHash": { "$ref": "#/$defs/digest" } }
        }
      }
    }
  }
}
